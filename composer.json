{
    "require": {
        "phpmailer/phpmailer": "^7.0",
        "sendgrid/sendgrid": "^8.1",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Services\\": "app/services/",
            "App\\Core\\": "app/core/",
            "App\\Config\\": "config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-verbose": "phpunit --testdox"
    },
    "config": {
        "optimize-autoloader": true
    }
}
